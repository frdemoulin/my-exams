# Example environment variables for local development
# Copy to .env.local and fill with real values (never commit .env.local)

# Database
DATABASE_URL="<URI_MONGODB>"

# Auth.js / NextAuth
AUTH_SECRET="replace_with_openssl_rand_base64_32"
WATERMARK_SECRET=
AUTH_REDIRECT_PROXY_URL="http://localhost:3000/api/auth"
AUTH_COOKIE_DOMAIN=".lvh.me"
APP_HOST="app.lvh.me"
HEALTH_HOST="sante.lvh.me"
HEALTH_PUBLIC_URL="http://sante.lvh.me:3000"

# Email (magic link) — required to enable EmailProvider
AUTH_EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
AUTH_EMAIL_FROM="My exams <no-reply@votre-domaine.fr>"

# Auth logs (retention CNIL, in days)
AUTH_LOG_RETENTION_DAYS=180

# Usage stats & error logs
USAGE_EVENT_RETENTION_DAYS=180
ERROR_LOG_RETENTION_DAYS=180
USAGE_DAILY_RETENTION_DAYS=730
USAGE_STATS_LOOKBACK_DAYS=3
USAGE_STATS_WINDOW_DAYS=90
API_SLOW_THRESHOLD_MS=3000
