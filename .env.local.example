# Example environment variables for local development
# Copy to .env.local and fill with real values (never commit .env.local)

# Database
DATABASE_URL="<URI_MONGODB>"

# Auth.js / NextAuth
AUTH_SECRET="replace_with_openssl_rand_base64_32"
WATERMARK_SECRET="replace_with_openssl_rand_base64_32"
AUTH_REDIRECT_PROXY_URL="http://localhost:3000/api/auth"
AUTH_COOKIE_DOMAIN=".lvh.me"
APP_HOST="app.lvh.me"
HEALTH_HOST="sante.lvh.me"
HEALTH_PUBLIC_URL="http://sante.lvh.me:3000"

# Email (magic link) — required to enable EmailProvider
# Format: smtp://user:pass@smtp.example.com:587
AUTH_EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
AUTH_EMAIL_FROM="My exams <no-reply@votre-domaine.fr>"

# Auth logs (retention CNIL, in days)
AUTH_LOG_RETENTION_DAYS=180

# Usage stats & error logs
USAGE_EVENT_RETENTION_DAYS=180
ERROR_LOG_RETENTION_DAYS=180
USAGE_DAILY_RETENTION_DAYS=730
USAGE_STATS_LOOKBACK_DAYS=3
USAGE_STATS_WINDOW_DAYS=90
API_SLOW_THRESHOLD_MS=3000

# Umami (admin embed)
# UMAMI_SHARE_URL="https://umami.example.com/share/<shareId>/my-exams"
# UMAMI_DASHBOARD_URL="https://umami.example.com"

# Example for testing with Mailtrap / Ethereal / OVH — replace with your provider credentials
# For Mailtrap: smtp://username:password@smtp.mailtrap.io:587
# For OVH: smtp://user:pass@smtp.mail.ovh.net:465

# OAuth providers (optional)
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
# AUTH_FACEBOOK_ID=...
# AUTH_FACEBOOK_SECRET=...

# NOTES:
# - Copy this file to .env.local and fill values before running `npm run dev`.
# - To test email sending without a real SMTP, use Mailtrap or a similar service.

# Optional (prod): persist uploaded PDFs outside the container
# UPLOADS_DIR="/data/uploads"
